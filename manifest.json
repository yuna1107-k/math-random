{
  "manifest_version": 3,
  "name": "math-random",
  "version": "0.1.0",
  "description": "画面上のテキストを文字コード経由でランダムな基数表現に書き換えて表示します。",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
